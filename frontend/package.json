{
  "name": "f-case-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write .",
    "generate:api": "rm -rf ./src/generated/* && curl -o docs.json http://localhost:8082/docs && npx openapi-typescript-codegen --input docs.json --output ./src/generated",
    "generate:routes": "tsr generate"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.11",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.545.0",
    "openapi-typescript-codegen": "^0.30.0",
    "react": "^19.2.0",
    "react-confirm": "^0.5.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.88.0",
    "styled-components": "^6.3.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-config": "^0.3.0",
    "@tanstack/router-cli": "^1.166.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
